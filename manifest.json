{
  "manifest_version": 3,
  "name": "Tıbbi Not Defteri",
  "version": "1.3.0",
  "description": "Pratisyen hekimler için hızlı tıbbi not yakalama ve düzenleme sistemi",

  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "contextMenus",
    "nativeMessaging"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js", "content/floating-button.js", "content/ai-parser.js", "content/qa-buttons.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://gemini.google.com/*",
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://grok.com/*",
        "*://x.com/*",
        "*://copilot.microsoft.com/*",
        "*://*.perplexity.ai/*"
      ],
      "js": ["content/scroll-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://gemini.google.com/*",
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://grok.com/*",
        "*://x.com/*",
        "*://copilot.microsoft.com/*",
        "*://*.perplexity.ai/*"
      ],
      "js": ["content/scroll-patch.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "commands": {
    "capture-selection": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Seçili metni deftere aktar"
    },
    "parse-last-response": {
      "suggested_key": {
        "default": "Alt+1"
      },
      "description": "Son AI yanıtını paragraflara böl"
    },
    "capture-full-response": {
      "suggested_key": {
        "default": "Alt+2"
      },
      "description": "Son AI yanıtının tamamını deftere aktar"
    },
    "capture-qa": {
      "suggested_key": {
        "default": "Alt+3"
      },
      "description": "Okunan cevabı sorusuyla birlikte deftere aktar"
    }
  }
}
